[Default Applications]
inode/directory=fun.wmde.files.desktop
inode/mount-point=fun.wmde.files.desktop
# Text goes to wmde-edit, the notepad, assigned exactly the types that MimeType= of its own
# desktop entry declares, all in their canonical shared-mime-info form: plain text, empty
# files, logs and readmes, configuration and data formats, scripts and source code. Text
# that has an application of its own is left to it - HTML to the browser, CSV and TSV to
# the spreadsheet, SVG to the viewer, calendars, contacts, mail, playlists, subtitles,
# rich text - and so are .desktop files, which Files launches.
text/plain=fun.wmde.Edit.desktop
application/x-zerosize=fun.wmde.Edit.desktop
text/x-log=fun.wmde.Edit.desktop
text/markdown=fun.wmde.Edit.desktop
